# =============================================================
# TRACK — root .gitignore
# =============================================================

# ── Python / Django ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.pycache

# Virtual environments
.venv/
venv/
env/
ENV/

# Django local
backend/db.sqlite3
backend/track_db.sqlite3
*.sqlite3
backend/media/
backend/staticfiles/
backend/static_collected/

# Secrets — never commit real env files
.env
.env.local
.env.*.local
backend/.env
backend/.env.*

# Python packaging
*.egg-info/
dist/
build/
*.egg

# ── Node / Frontend ──────────────────────────────────────────
# (frontend/.gitignore already covers node_modules & dist;
#  these are belt-and-suspenders at root level)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# ── Editor & OS ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Misc ─────────────────────────────────────────────────────
*.local
.cache/

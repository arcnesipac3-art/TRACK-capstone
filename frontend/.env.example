# TRACK frontend environment — copy this file to .env and fill in values
# All /api/* requests are proxied to Django by the Vite dev server

# Base URL for API requests (use /api for local dev with Vite proxy)
VITE_API_BASE_URL=/api

# Public origin the app is served from (used for og:image / twitter:image URLs)
VITE_SITE_URL=http://localhost:5173

# TRACK frontend environment — copy this file to .env and fill in values
# All /api/* requests are proxied to Django by the Vite dev server

# Base URL for API requests (use /api for local dev with Vite proxy)
VITE_API_BASE_URL=/api

# Public origin the app is served from (used for og:image / twitter:image URLs)
VITE_SITE_URL=http://localhost:5173

# Dev only: where the Vite proxy forwards /api/* — REST and the messaging
# WebSocket upgrade. Set it when the ASGI server is not on port 8000, e.g.
#   daphne config.asgi:application -p 8010 -b 127.0.0.1   (backend)
#   VITE_PROXY_TARGET=http://127.0.0.1:8010 npm run dev -- --port 5199
# VITE_PROXY_TARGET=http://127.0.0.1:8000

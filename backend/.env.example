# TRACK backend environment
#
# Local dev:   cp .env.example .env   (settings.py loads backend/.env if it
#               exists; values already set in the shell are never overridden)
# Production:  set these as real environment variables on the host — NEVER
#               upload a .env file to the server. backend/.env is gitignored.
#
# Generate a secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ---------------------------------------------------------------------------
# Development (everything below has safe defaults — delete this file and the
# app still runs on SQLite with DEBUG=True on localhost).
# ---------------------------------------------------------------------------

# Extra allowed Host headers for LAN/device testing (comma-separated), e.g.
# the LAN IP of your machine when testing the Expo app on a physical phone.
# DJANGO_EXTRA_ALLOWED_HOSTS=192.168.1.10

# Login brute-force throttle: DRF scoped rate for /auth/login/ + /auth/token/.
# TRACK_AUTH_THROTTLE_RATE=10/min

# ---------------------------------------------------------------------------
# Production — required when DJANGO_PRODUCTION=1 (the app refuses to boot
# without SECRET_KEY and DJANGO_ALLOWED_HOSTS in that mode).
# ---------------------------------------------------------------------------

# Master switch: enables DEBUG=False, secure cookies, HSTS, HTTPS redirect,
# host allow-list, and CORS/CSRF origin restrictions.
# DJANGO_PRODUCTION=1

# SECRET_KEY=change-me-to-a-random-generated-value

# Public hostname(s), comma-separated (scheme excluded):
# DJANGO_ALLOWED_HOSTS=track.knhs.edu.ph

# Trusted browser origins for CSRF + CORS, comma-separated, scheme included.
# Defaults to https://<host> for each DJANGO_ALLOWED_HOSTS entry if unset.
# DJANGO_CSRF_ORIGINS=https://track.knhs.edu.ph

# PostgreSQL connection string (Render/Railway/Heroku style). Unset = SQLite
# (backend/track_db.sqlite3) as in development.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Force HTTPS redirect is ON in production. Set to 0 only for plain-HTTP
# rehearsals or behind a proxy that does not set X-Forwarded-Proto.
# DJANGO_SECURE_SSL_REDIRECT=1

# ---------------------------------------------------------------------------
# Real-time messaging (core/messaging*.py, core/consumers via /api/ws/messaging/)
# ---------------------------------------------------------------------------

# Channel layer for WebSocket fan-out. Unset = InMemoryChannelLayer, which only
# works in ONE ASGI process (see docs/KNOWN_LIMITATIONS.md L-019). Set this the
# moment the app runs behind more than one worker, or live events stop crossing
# processes:
# REDIS_URL=redis://127.0.0.1:6379/0

# Browser origins allowed to open the messaging socket, comma-separated, scheme
# included. The CORS/CSRF origin lists are always accepted too, and a handshake
# with no Origin header (a native app) is judged on its credential alone. In
# development the browser connects through the Vite dev server, so add that
# origin here when you run the ASGI server on its own port:
# TRACK_WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5199

# Send + ws-ticket rate limit (per user). The socket enforces the same window
# itself, because a live connection has no requests to throttle.
# TRACK_MESSAGING_THROTTLE_RATE=60/min

# Web push. Without BOTH keys push stays off and the UI says so; in-app bells
# and live events do not need them. Generate:
#   python backend/manage.py generate_vapid_keys
# VAPID_PUBLIC_KEY=BF0pp...base64url
# VAPID_PRIVATE_KEY is the PEM itself (pywebpush also accepts a path to a
# .pem file here, which is easier when the platform cannot hold a newline):
# VAPID_PRIVATE_KEY=vapid_private.pem
# VAPID_SUBJECT=mailto:admin@your-school.example

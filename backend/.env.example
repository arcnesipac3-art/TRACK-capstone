# TRACK backend environment
#
# Local dev:   cp .env.example .env   (settings.py loads backend/.env if it
#               exists; values already set in the shell are never overridden)
# Production:  set these as real environment variables on the host — NEVER
#               upload a .env file to the server. backend/.env is gitignored.
#
# Generate a secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ---------------------------------------------------------------------------
# Development (everything below has safe defaults — delete this file and the
# app still runs on SQLite with DEBUG=True on localhost).
# ---------------------------------------------------------------------------

# Extra allowed Host headers for LAN/device testing (comma-separated), e.g.
# the LAN IP of your machine when testing the Expo app on a physical phone.
# DJANGO_EXTRA_ALLOWED_HOSTS=192.168.1.10

# Login brute-force throttle: DRF scoped rate for /auth/login/ + /auth/token/.
# TRACK_AUTH_THROTTLE_RATE=10/min

# ---------------------------------------------------------------------------
# Production — required when DJANGO_PRODUCTION=1 (the app refuses to boot
# without SECRET_KEY and DJANGO_ALLOWED_HOSTS in that mode).
# ---------------------------------------------------------------------------

# Master switch: enables DEBUG=False, secure cookies, HSTS, HTTPS redirect,
# host allow-list, and CORS/CSRF origin restrictions.
# DJANGO_PRODUCTION=1

# SECRET_KEY=change-me-to-a-random-generated-value

# Public hostname(s), comma-separated (scheme excluded):
# DJANGO_ALLOWED_HOSTS=track.knhs.edu.ph

# Trusted browser origins for CSRF + CORS, comma-separated, scheme included.
# Defaults to https://<host> for each DJANGO_ALLOWED_HOSTS entry if unset.
# DJANGO_CSRF_ORIGINS=https://track.knhs.edu.ph

# PostgreSQL connection string (Render/Railway/Heroku style). Unset = SQLite
# (backend/track_db.sqlite3) as in development.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Force HTTPS redirect is ON in production. Set to 0 only for plain-HTTP
# rehearsals or behind a proxy that does not set X-Forwarded-Proto.
# DJANGO_SECURE_SSL_REDIRECT=1
